# Private practice catalogue inputs and outputs. These patterns protect future
# files after the existing private blobs have been removed from Git history; an
# ignore rule does not untrack a file that is already committed.
docs/pdfs/
scores/family/
frontend/src/data/familyScores.json
frontend/src/data/familyScores.private.json
recordings/
practice-recordings/

# Local-only credentials not covered above
*.pem
*.p12

# External plugins (maintained in a separate private repository)
plugins-external/
# Built plugin ZIPs (build artifacts from plugins-external/)
*.zip

# Android TWA project (android/)
*.keystore
*.jks
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/app/google-services.json
# Android build artifacts (release outputs — not source)
android/*.apk
android/*.aab
android/*.idsig

.specify/extensions/.cache/
.worktrees/
